rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function isAdminEmail() {
      return signedIn() &&
        request.auth.token.email == 'kevlimpens@gmail.com';
    }

    function isAdmin() {
      return signedIn() && (
        userDoc().data.role == 'admin' ||
        userDoc().data.role == 'supervisor' ||
        isAdminEmail()
      );
    }

    /* Inleveringen bij praktijkopdrachten: een Word-, PDF- of afbeeldingsbestand
       per opgave. Vervangbaar (update) zolang de docent nog niet beoordeeld
       heeft; die grens bewaakt de app, hier ligt alleen het eigendom vast. */
    match /inleveringen/{userId}/{allPaths=**} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.*')
            || request.resource.contentType == 'application/msword');
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    /* Schermafbeeldingen bij meldingen. Het pad draagt de uid van de melder,
       zodat de regels de eigenaar kennen zonder Firestore erbij te halen.
       Niet overschrijven: een melding hoort te tonen wat er toen te zien was. */
    match /meldingen/{userId}/{bestand} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 2 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Bestaande crop/OCR uploads
    match /pythagoras/question-crops/{allPaths=**} {
      allow read, write: if signedIn();
    }

    match /pythagoras/source-pages/{allPaths=**} {
      allow read, write: if signedIn();
    }

    // Slidedeckcreator: bron-PDF, assets en NotebookLM deck-PDF
    match /slidedecks/{allPaths=**} {
      allow read, write: if signedIn();
    }

    // CMS mediablokken: afbeeldingen, video's en media-PDF's
    match /mediaBlocks/{allPaths=**} {
      allow read, write: if signedIn();
    }

    // Tijdelijke leerlingfoto-imports. Elke ingelogde gebruiker kan tijdelijk
    // uploaden; definitieve goedkeuring blijft streng bewaakt via Cloud Functions.
    match /photo-imports/{klasId}/{importId}/{allPaths=**} {
      allow read, write: if signedIn();
    }

    // Definitieve leerlingfoto's. Schrijven gebeurt alleen via Admin SDK in
    // Cloud Functions. Iedere ingelogde gebruiker mag avatars lezen, zodat
    // beheerlijsten, klasoverzichten en leerlingroutes geen Storage-403 geven.
    match /student-photos/{klasId}/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Token-shopafbeeldingen worden door admins beheerd en door ingelogde
    // gebruikers gelezen in de shop en beheerschermen.
    match /token-shop-items/{itemId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
