rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdminEmail() {
      return signedIn() &&
        request.auth.token.email == 'kevlimpens@gmail.com';
    }

    function isAdmin() {
      return signedIn() && (
        userDoc().data.role == 'admin' || isAdminEmail()
      );
    }

    function isSupervisor() {
      return signedIn() && userDoc().data.role == 'supervisor';
    }

    function isAdminOrSupervisor() {
      return isAdmin() || isSupervisor();
    }

    // Zelf een account aanmaken mag alleen met schoolmail. Dezelfde lijst staat
    // in src/lib/allowedEmailDomains.js; houd beide gelijk.
    function heeftSchoolEmail() {
      return signedIn() && (
        string(request.auth.token.email).lower().matches('.*@leerling[.]dacapo-college[.]nl') ||
        string(request.auth.token.email).lower().matches('.*@stichtinglvo[.]nl')
      );
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasStudentKlas() {
      return signedIn() &&
        userDoc().data.klasId is string &&
        exists(/databases/$(database)/documents/klassen/$(userDoc().data.klasId));
    }

    function studentKlasDoc() {
      return get(/databases/$(database)/documents/klassen/$(userDoc().data.klasId));
    }

    function isPublishedPublicResource() {
      return resource.data.status == 'published' &&
        resource.data.isArchived != true;
    }

    function hasClassAssignedParagraph(paragraafId) {
      return studentKlasDoc().data.keys().hasAny(['enabledParagrafen']) &&
        studentKlasDoc().data.enabledParagrafen.hasAny([paragraafId]);
    }

    function hasStudentOverride() {
      return studentKlasDoc().data.keys().hasAny(['studentOverrides']) &&
        studentKlasDoc().data.studentOverrides.keys().hasAny([request.auth.uid]);
    }

    function hasStudentAssignedParagraph(paragraafId) {
      return hasStudentOverride() &&
        studentKlasDoc().data.studentOverrides[request.auth.uid].keys().hasAny(['extraParagrafen']) &&
        studentKlasDoc().data.studentOverrides[request.auth.uid].extraParagrafen.hasAny([paragraafId]);
    }

    function isAssignedParagraph(paragraafId) {
      return hasStudentKlas() && (
        hasClassAssignedParagraph(paragraafId) ||
        hasStudentAssignedParagraph(paragraafId)
      );
    }

    function hasExplicitClassContentSelection(paragraafId) {
      return studentKlasDoc().data.keys().hasAny(['enabledContentBlocks']) &&
        studentKlasDoc().data.enabledContentBlocks.keys().hasAny([paragraafId]);
    }

    function hasClassAssignedContentBlock(paragraafId, blockId) {
      return hasExplicitClassContentSelection(paragraafId) &&
        blockId in studentKlasDoc().data.enabledContentBlocks[paragraafId] &&
        studentKlasDoc().data.enabledContentBlocks[paragraafId].hasAny([blockId]);
    }

    function hasStudentAssignedContentBlock(paragraafId, blockId) {
      return hasStudentOverride() &&
        studentKlasDoc().data.studentOverrides[request.auth.uid].keys().hasAny(['extraContentBlocks']) &&
        studentKlasDoc().data.studentOverrides[request.auth.uid].extraContentBlocks.keys().hasAny([paragraafId]) &&
        studentKlasDoc().data.studentOverrides[request.auth.uid].extraContentBlocks[paragraafId].hasAny([blockId]);
    }

    function isAssignedContentBlock(paragraafId, blockId) {
      return isAssignedParagraph(paragraafId) && (
        (
          !hasExplicitClassContentSelection(paragraafId) &&
          !hasStudentAssignedContentBlock(paragraafId, blockId)
        ) ||
        hasClassAssignedContentBlock(paragraafId, blockId) ||
        hasStudentAssignedContentBlock(paragraafId, blockId)
      );
    }

    function canReadPublicParagraphContent() {
      return isAdminOrSupervisor() || (
        isPublishedPublicResource() &&
        isAssignedParagraph(resource.data.paragraafId)
      );
    }

    function canReadPublicContentBlock(blockId) {
      return isAdminOrSupervisor() || (
        isPublishedPublicResource() &&
        isAssignedContentBlock(resource.data.paragraafId, blockId)
      );
    }

    // Gebruikers
    // De rol van een account mag de eigenaar zelf nooit veranderen; anders kan
    // elke ingelogde leerling zichzelf tot admin maken. Beheerders houden hun
    // rechten. Het vaste admin-e-mailadres mag zijn eigen rol wel gelijktrekken,
    // omdat de app die na het inloggen naar 'admin' synchroniseert.
    function rolBlijftGelijk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    // Een oud document zonder rol mag door de app zelf op 'student' gezet
    // worden (AuthProvider synchroniseert de rol na het inloggen).
    function rolWordtStudentIngevuld() {
      return !('role' in resource.data) && request.resource.data.role == 'student';
    }

    function nieuweRolIsStudent() {
      return request.resource.data.get('role', 'student') == 'student';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdminOrSupervisor();
      // Een nieuw eigen account vereist schoolmail en start altijd als leerling;
      // beheerders mogen altijd.
      allow create: if (isOwner(userId) && heeftSchoolEmail() && nieuweRolIsStudent())
        || isAdminOrSupervisor();
      allow update: if (isOwner(userId) && (rolBlijftGelijk() || rolWordtStudentIngevuld() || isAdminEmail()))
        || isAdminOrSupervisor();
      allow delete: if isAdminOrSupervisor();
    }

    // Antwoorden
    match /userAnswers/{docId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // CMS content
    match /vakken/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /vak/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /leerjaar/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /niveau/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /hoofdstuk/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /paragraaf/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /vraag/{document=**} {
      allow read: if isAdminOrSupervisor();
      allow create, update, delete: if isAdmin();
    }

    match /publicQuestions/{document=**} {
      allow read: if canReadPublicParagraphContent();
      allow create, update, delete: if isAdmin();
    }

    match /contentBlocks/{document=**} {
      allow read: if isAdminOrSupervisor();
      allow create, update, delete: if isAdmin();
    }

    match /publicContentBlocks/{blockId} {
      allow read: if canReadPublicContentBlock(blockId);
      allow create, update, delete: if isAdmin();
    }

    // Slidedeckcreator / NotebookLM
    match /promptTemplates/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Server-only provider secrets/config. Gebruik Cloud Functions; nooit direct vanuit de client.
    match /privateConfig/{document=**} {
      allow read, write: if false;
    }

    // Beheerbare P-AI-co tutorregels. Leerlingen mogen deze regels niet zien of aanpassen.
    match /apps/helix/settings/aiTutorRules {
      allow read, create, update: if isAdminOrSupervisor();
      allow delete: if isAdmin();
    }

    match /slidedeckPackages/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Klassen
    match /klassen/{klasId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Voortgang
    match /voortgang/{docId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if signedIn() && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid
        ) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Persoonlijk startprofiel uit de nulmeting digitale vaardigheden. Wordt
    // alleen door de Cloud Function buildNulmetingProfiel geschreven (Admin
    // SDK, buiten deze regels om). Een leerling leest uitsluitend zijn eigen
    // profiel; docenten alles. Geen schrijfrechten vanuit de client, zodat een
    // leerling zijn profiel niet zelf kan aanpassen.
    match /nulmetingProfielen/{userId} {
      allow read: if isOwner(userId) || isAdminOrSupervisor();
      allow create, update, delete: if false;
    }

    // Voortgang per vraag binnen een toets of quiz.
    // Een toets is een blok, maar de docent kijkt per vraag. Zelfde eigenaars-
    // toets als het ouderdocument: een leerling leest en schrijft alleen zijn
    // eigen items, een admin alles. Verwijderen blijft aan de admin, zodat een
    // leerling zijn eigen pogingengeschiedenis niet kan wissen.
    match /voortgang/{docId}/items/{itemId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if signedIn() && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid
        ) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Collectiegroep-lezing van toets- en quizitems.
    // De nakijkstapel van de docent haalt alle wachtende beoordelingen op met
    // collectionGroup('items'); een padregel hierboven dekt zo'n query niet.
    // Bewust admin-only: deze query filtert niet op uid en levert dus items
    // van alle leerlingen. Leerlingen houden hun eigen toegang via het pad.
    match /{path=**}/items/{itemId} {
      allow read: if isAdmin();
    }

    // Door docenten/admins afgevinkte voortgangssignalen.
    // Leerlingen zien of wijzigen deze moderatiestatus niet.
    match /progressSignalAcknowledgements/{signalId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Rem tegen het aftasten van antwoorden. Alleen de callable
    // gradeClosedQuestion schrijft hier; een leerling mag zijn eigen teller
    // niet lezen of wissen.
    match /questionGradingRateLimits/{limitId} {
      allow read, create, update, delete: if false;
    }

    // Tokensysteem. Saldo's en ledger muteren uitsluitend via Cloud Functions.
    match /tokenAccounts/{studentUid} {
      allow read: if isOwner(studentUid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /tokenTransactions/{transactionId} {
      allow read: if signedIn() && (
        resource.data.studentUid == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /tokenPurchases/{purchaseId} {
      allow read: if signedIn() && (
        resource.data.studentUid == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /studentTokenLoadouts/{studentUid} {
      allow read: if isOwner(studentUid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /tokenAwardClaims/{claimId} {
      allow read, create, update, delete: if false;
    }

    match /tokenShopItems/{itemId} {
      allow read: if isAdmin() || (
        signedIn() &&
        resource.data.enabled == true
      );
      allow create, update, delete: if isAdmin();
    }

    // Per-spel instellingen (tokenbeloning + speellimiet).
    // Leerlingen mogen lezen zodat de speellimiet client-side kan worden gehandhaafd;
    // muteren blijft admin-only.
    match /tokenGameRewardRules/{gameId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Spelinstellingen die de docent klaarzet, zoals de woordenlijst van
    // DVLingo. Leerlingen lezen ze mee bij het starten van het spel.
    match /gameInstellingen/{gameId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Leerling-foutmeldingen.
    // Leerlingen mogen alleen eigen meldingen aanmaken en teruglezen voor rate limiting.
    // Moderatie, status en adminnotities blijven admin-only.
    /* Meldingen van de meldbel rechtsonder. De grenzen:
       - iedereen die is ingelogd mag melden, maar alleen namens zichzelf;
       - je leest alleen je eigen meldingen, het beheer leest alles;
       - status en reactie zijn van het beheer;
       - de melder mag een ding aan zijn eigen melding wijzigen: aangeven dat
         hij het antwoord gelezen heeft (dat zet het rode bolletje uit). */
    match /meldingen/{meldingId} {
      function isMelder() {
        return signedIn() && resource.data.melder.uid == request.auth.uid;
      }

      allow read: if isAdminOrSupervisor() || isMelder();

      /* Bij het aanmaken ligt de status vast op 'nieuw' en is er nog geen
         reactie, anders kan een melding er al afgehandeld uitzien en zo
         tussen de openstaande punten uit glippen. */
      allow create: if signedIn()
        && request.resource.data.melder.uid == request.auth.uid
        && request.resource.data.status == 'nieuw'
        && request.resource.data.reactie == ''
        && request.resource.data.tekst is string
        && request.resource.data.tekst.size() > 0
        && request.resource.data.tekst.size() <= 4000
        && request.resource.data.aangemaakt is timestamp;

      allow update: if isAdminOrSupervisor()
        || (isMelder()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['gelezenDoorMelder']));
    }

    match /studentBugReports/{reportId} {
      allow read: if signedIn() && (
        resource.data.student.uid == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() &&
        request.resource.data.student.uid == request.auth.uid &&
        request.resource.data.status == 'new' &&
        request.resource.data.adminNote == '' &&
        request.resource.data.category is string &&
        request.resource.data.description is string;

      allow update, delete: if isAdmin();
    }

    // Leerlingfoto-import: tijdelijke importmetadata en croprecords.
    // Definitief koppelen naar users/{uid}.photo gebeurt via Cloud Functions.
    match /photoImports/{importId} {
      allow read, create, update, delete: if isAdmin();

      match /crops/{cropId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    // Nieuwe leerlingen die uit een foto-import nog handmatig verwerkt moeten worden.
    match /pendingStudents/{document=**} {
      allow read, create, update, delete: if isAdmin();
    }

    // Crop metadata
    match /questionMetadata/{paragraphId}/questions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Nodig voor collectionGroup(db, 'questions') bij CMS-reset
    match /{path=**}/questions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
