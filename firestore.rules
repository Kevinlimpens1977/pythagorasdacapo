rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && userDoc().data.role == 'admin';
    }

    function isSupervisor() {
      return signedIn() && userDoc().data.role == 'supervisor';
    }

    function isAdminOrSupervisor() {
      return isAdmin() || isSupervisor();
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasStudentKlas() {
      return signedIn() &&
        userDoc().data.klasId is string &&
        exists(/databases/$(database)/documents/klassen/$(userDoc().data.klasId));
    }

    function studentKlasDoc() {
      return get(/databases/$(database)/documents/klassen/$(userDoc().data.klasId));
    }

    function isPublishedPublicResource() {
      return resource.data.status == 'published' &&
        resource.data.isArchived != true;
    }

    function hasClassAssignedParagraph(paragraafId) {
      return studentKlasDoc().data.keys().hasAny(['enabledParagrafen']) &&
        studentKlasDoc().data.enabledParagrafen.hasAny([paragraafId]);
    }

    function hasStudentOverride() {
      return studentKlasDoc().data.keys().hasAny(['studentOverrides']) &&
        studentKlasDoc().data.studentOverrides.keys().hasAny([request.auth.uid]);
    }

    function hasStudentAssignedParagraph(paragraafId) {
      return hasStudentOverride() &&
        studentKlasDoc().data.studentOverrides[request.auth.uid].keys().hasAny(['extraParagrafen']) &&
        studentKlasDoc().data.studentOverrides[request.auth.uid].extraParagrafen.hasAny([paragraafId]);
    }

    function isAssignedParagraph(paragraafId) {
      return hasStudentKlas() && (
        hasClassAssignedParagraph(paragraafId) ||
        hasStudentAssignedParagraph(paragraafId)
      );
    }

    function hasExplicitClassContentSelection(paragraafId) {
      return studentKlasDoc().data.keys().hasAny(['enabledContentBlocks']) &&
        studentKlasDoc().data.enabledContentBlocks.keys().hasAny([paragraafId]);
    }

    function hasClassAssignedContentBlock(paragraafId, blockId) {
      return hasExplicitClassContentSelection(paragraafId) &&
        blockId in studentKlasDoc().data.enabledContentBlocks[paragraafId] &&
        studentKlasDoc().data.enabledContentBlocks[paragraafId].hasAny([blockId]);
    }

    function hasStudentAssignedContentBlock(paragraafId, blockId) {
      return hasStudentOverride() &&
        studentKlasDoc().data.studentOverrides[request.auth.uid].keys().hasAny(['extraContentBlocks']) &&
        studentKlasDoc().data.studentOverrides[request.auth.uid].extraContentBlocks.keys().hasAny([paragraafId]) &&
        studentKlasDoc().data.studentOverrides[request.auth.uid].extraContentBlocks[paragraafId].hasAny([blockId]);
    }

    function isAssignedContentBlock(paragraafId, blockId) {
      return isAssignedParagraph(paragraafId) && (
        (
          !hasExplicitClassContentSelection(paragraafId) &&
          !hasStudentAssignedContentBlock(paragraafId, blockId)
        ) ||
        hasClassAssignedContentBlock(paragraafId, blockId) ||
        hasStudentAssignedContentBlock(paragraafId, blockId)
      );
    }

    function canReadPublicParagraphContent() {
      return isAdminOrSupervisor() || (
        isPublishedPublicResource() &&
        isAssignedParagraph(resource.data.paragraafId)
      );
    }

    function canReadPublicContentBlock(blockId) {
      return isAdminOrSupervisor() || (
        isPublishedPublicResource() &&
        isAssignedContentBlock(resource.data.paragraafId, blockId)
      );
    }

    // Gebruikers
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Antwoorden
    match /userAnswers/{docId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // CMS content
    match /vakken/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /vak/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /leerjaar/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /niveau/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /hoofdstuk/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /paragraaf/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /vraag/{document=**} {
      allow read: if isAdminOrSupervisor();
      allow create, update, delete: if isAdmin();
    }

    match /publicQuestions/{document=**} {
      allow read: if canReadPublicParagraphContent();
      allow create, update, delete: if isAdmin();
    }

    match /contentBlocks/{document=**} {
      allow read: if isAdminOrSupervisor();
      allow create, update, delete: if isAdmin();
    }

    match /publicContentBlocks/{blockId} {
      allow read: if canReadPublicContentBlock(blockId);
      allow create, update, delete: if isAdmin();
    }

    // Slidedeckcreator / NotebookLM
    match /promptTemplates/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Server-only provider secrets/config. Gebruik Cloud Functions; nooit direct vanuit de client.
    match /privateConfig/{document=**} {
      allow read, write: if false;
    }

    // Beheerbare P-AI-co tutorregels. Leerlingen mogen deze regels niet zien of aanpassen.
    match /apps/helix/settings/aiTutorRules {
      allow read, create, update: if isAdminOrSupervisor();
      allow delete: if isAdmin();
    }

    match /slidedeckPackages/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Klassen
    match /klassen/{klasId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Voortgang
    match /voortgang/{docId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if signedIn() && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid
        ) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Door docenten/admins afgevinkte voortgangssignalen.
    // Leerlingen zien of wijzigen deze moderatiestatus niet.
    match /progressSignalAcknowledgements/{signalId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Tokensysteem. Saldo's en ledger muteren uitsluitend via Cloud Functions.
    match /tokenAccounts/{studentUid} {
      allow read: if isOwner(studentUid) || isAdmin();
      allow create, update, delete: if false;
    }

    match /tokenTransactions/{transactionId} {
      allow read: if signedIn() && (
        resource.data.studentUid == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /tokenPurchases/{purchaseId} {
      allow read: if signedIn() && (
        resource.data.studentUid == request.auth.uid ||
        isAdmin()
      );
      allow create, update, delete: if false;
    }

    match /tokenAwardClaims/{claimId} {
      allow read, create, update, delete: if false;
    }

    match /tokenShopItems/{itemId} {
      allow read: if isAdmin() || (
        signedIn() &&
        resource.data.enabled == true
      );
      allow create, update, delete: if isAdmin();
    }

    // Leerling-foutmeldingen.
    // Leerlingen mogen alleen eigen meldingen aanmaken en teruglezen voor rate limiting.
    // Moderatie, status en adminnotities blijven admin-only.
    match /studentBugReports/{reportId} {
      allow read: if signedIn() && (
        resource.data.student.uid == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() &&
        request.resource.data.student.uid == request.auth.uid &&
        request.resource.data.status == 'new' &&
        request.resource.data.adminNote == '' &&
        request.resource.data.category is string &&
        request.resource.data.description is string;

      allow update, delete: if isAdmin();
    }

    // Leerlingfoto-import: tijdelijke importmetadata en croprecords.
    // Definitief koppelen naar users/{uid}.photo gebeurt via Cloud Functions.
    match /photoImports/{importId} {
      allow read, create, update, delete: if isAdmin();

      match /crops/{cropId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    // Nieuwe leerlingen die uit een foto-import nog handmatig verwerkt moeten worden.
    match /pendingStudents/{document=**} {
      allow read, create, update, delete: if isAdmin();
    }

    // Crop metadata
    match /questionMetadata/{paragraphId}/questions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Nodig voor collectionGroup(db, 'questions') bij CMS-reset
    match /{path=**}/questions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
