rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && userDoc().data.role == 'admin';
    }

    function isSupervisor() {
      return signedIn() && userDoc().data.role == 'supervisor';
    }

    function isAdminOrSupervisor() {
      return isAdmin() || isSupervisor();
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Gebruikers
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Antwoorden
    match /userAnswers/{docId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // CMS content
    match /vakken/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /vak/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /leerjaar/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /niveau/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /hoofdstuk/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /paragraaf/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /vraag/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /contentBlocks/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Slidedeckcreator / NotebookLM
    match /promptTemplates/{document=**} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Server-only provider secrets/config. Gebruik Cloud Functions; nooit direct vanuit de client.
    match /privateConfig/{document=**} {
      allow read, write: if false;
    }

    // Beheerbare P-AI-co tutorregels. Leerlingen mogen deze regels niet zien of aanpassen.
    match /apps/helix/settings/aiTutorRules {
      allow read, create, update: if isAdminOrSupervisor();
      allow delete: if isAdmin();
    }

    match /slidedeckPackages/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Klassen
    match /klassen/{klasId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Voortgang
    match /voortgang/{docId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if signedIn() && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid
        ) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // Leerling-foutmeldingen.
    // Leerlingen mogen alleen eigen meldingen aanmaken en teruglezen voor rate limiting.
    // Moderatie, status en adminnotities blijven admin-only.
    match /studentBugReports/{reportId} {
      allow read: if signedIn() && (
        resource.data.student.uid == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() &&
        request.resource.data.student.uid == request.auth.uid &&
        request.resource.data.status == 'new' &&
        request.resource.data.adminNote == '' &&
        request.resource.data.category is string &&
        request.resource.data.description is string;

      allow update, delete: if isAdmin();
    }

    // Leerlingfoto-import: tijdelijke importmetadata en croprecords.
    // Definitief koppelen naar users/{uid}.photo gebeurt via Cloud Functions.
    match /photoImports/{importId} {
      allow read, create, update, delete: if isAdmin();

      match /crops/{cropId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    // Nieuwe leerlingen die uit een foto-import nog handmatig verwerkt moeten worden.
    match /pendingStudents/{document=**} {
      allow read, create, update, delete: if isAdmin();
    }

    // Crop metadata
    match /questionMetadata/{paragraphId}/questions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Nodig voor collectionGroup(db, 'questions') bij CMS-reset
    match /{path=**}/questions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
